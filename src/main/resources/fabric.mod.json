{
  "schemaVersion": 1,
  "id": "classycreepers-addon",
  "version": "${version}",
  "name": "Classy Creepers Addon",
  "description": "Gives creepers their original Classy Creepers top hats and monocles, with a LiquidBounce Render toggle.",
  "authors": ["NurMarvin", "CCBlueX"],
  "contact": {
    "homepage": "https://github.com/CCBlueX/classy-creepers"
  },
  "license": "CC0-1.0",
  "icon": "assets/classycreepers/icon.png",
  "environment": "client",
  "entrypoints": {
    "liquidbounce": [
      "net.ccbluex.classycreepers.addon.ClassyCreepersAddon"
    ]
  },
  "mixins": ["classycreepers-addon.mixins.json"],
  "depends": {
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabricloader": ">=${loader_version}",
    "liquidbounce": ">=${liquidbounce_version} <0.43.0"
  },
  "breaks": {
    "classycreepers": "*"
  },
  "custom": {
    "liquidbounce": {
      "color": "#51B44B"
    },
    "modmenu": {
      "parent": "liquidbounce"
    }
  }
}
